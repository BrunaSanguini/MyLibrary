{
  "name": "minha-livraria-frontend",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "api:types": "openapi-typescript ../docs/openapi.json -o src/app/core/api/schema.d.ts",
    "prestart": "npm run api:types",
    "start": "ng serve",
    "prebuild": "npm run api:types",
    "build": "ng build",
    "pretest": "npm run api:types",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "ng test --no-watch",
    "test:browser": "ng test --configuration browser --no-watch",
    "e2e": "playwright test",
    "e2e:typecheck": "tsc -p tsconfig.e2e.json --noEmit",
    "lint": "npm run lint:ts && npm run lint:css && npm run format:check",
    "lint:ts": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/router": "22.2.5",
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/mulish": "5.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@testing-library/angular": "19.6.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "angular-eslint": "22.6.0",
    "eslint": "10.14.0",
    "jsdom": "31.0.0",
    "openapi-typescript": "7.13.0",
    "playwright": "1.65.0",
    "prettier": "3.9.10",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "minimatch@>=7.0.0 <11.0.1": "11.0.5"
  }
}
