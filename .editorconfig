root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{java,xml}]
indent_size = 4
max_line_length = 120

# quote_type is not a core EditorConfig property (Angular CLI generates it too);
# single quotes are enforced by Prettier (singleQuote: true) in the front-end setup.
[*.ts]
quote_type = single

[*.{cmd,bat,ps1}]
end_of_line = crlf

[*.md]
max_line_length = off
trim_trailing_whitespace = false
